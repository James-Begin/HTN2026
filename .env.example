# Copy to .env in the project root. Never commit real values.
X_BEARER=your-x-bearer-token
OPENAI_API_KEY=your-openai-api-key
BASETEN_API_KEY=your-baseten-api-key
# Optional Baseten Embeddings Inference base URL, ending in /sync/v1.
# The endpoint is OpenAI-compatible and is used only for server-side candidate embeddings.
SEQUITOR_BASETEN_EMBED_URL=https://model-your-id.api.baseten.co/environments/production/sync/v1
SEQUITOR_BASETEN_EMBED_MODEL=not-required
# Optional local server port (default 8765)
SEQUITOR_PORT=8765
