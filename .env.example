# Copy to .env in the project root. Never commit real values.
X_BEARER=your-x-bearer-token
OPENAI_API_KEY=your-openai-api-key
# Optional planning/context model (default: gpt-4.1).
SEQUITOR_OPENAI_MODEL=gpt-4.1
BASETEN_API_KEY=your-baseten-api-key
# Fine-tuned OpenJev claim reranker (custom Truss .../production/predict).
# SEQUITOR_JEV_RERANK_URL=https://model-xxxxxxxx.api.baseten.co/production/predict
# Optional Chain for response roles + observed edges (.../run_remote).
# SEQUITOR_BASETEN_CHAIN_URL=https://chain-xxxxxxxx.api.baseten.co/run_remote
# Optional Baseten Embeddings Inference base URL, ending in /sync/v1.
# The endpoint is OpenAI-compatible and is used only for server-side candidate embeddings.
SEQUITOR_BASETEN_EMBED_URL=https://model-your-id.api.baseten.co/environments/production/sync/v1
SEQUITOR_BASETEN_EMBED_MODEL=not-required
# Sequitor ledger caps (not your X account balance). 0 = no Sequitor-side post cap.
SEQUITOR_X_POST_CAP=0
SEQUITOR_X_COUNTS_CAP=48
# Railway: attach a volume at /data; the app uses RAILWAY_VOLUME_MOUNT_PATH automatically.
# SEQUITOR_DATA_DIR=/data
# Optional local server port (default 8765)
SEQUITOR_PORT=8765
